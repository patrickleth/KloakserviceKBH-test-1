---
// Mini-CRM: ens for alle Vækster-kunder (neutralt design, ikke kundens branding).
// Henvendelser fra hjemmesidens formularer + manuelle leads. Liste og board, smarte lister, filtre, egne stages og visninger.
// Skjult adresse, noindex, ingen sporing, ikke i sitemap. Data hentes fra /administrator-system/api/ (netlify/functions/admin.mjs).
import '../../styles/admin.css';
import { site } from '../../lib/site';
---
<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#f5f5f7" />
  <title>Henvendelser · {site.name}</title>
</head>
<body class="crm">
  <main id="login" class="auth" hidden>
    <div class="auth-mark" aria-hidden="true">V</div>
    <form class="auth-card" data-login>
      <h1>Henvendelser</h1>
      <p class="sub">{site.name}</p>
      <div class="field-group">
        <input name="bruger" autocomplete="username" required autocapitalize="none" spellcheck="false" placeholder="Brugernavn" aria-label="Brugernavn" />
        <input name="kode" type="password" autocomplete="current-password" required placeholder="Adgangskode" aria-label="Adgangskode" />
      </div>
      <p class="msg err" role="alert" hidden></p>
      <p class="msg ok" role="status" hidden></p>
      <button class="btn btn-primary btn-wide" type="submit">Log ind</button>
      <button type="button" class="link" data-show-forgot>Glemt adgangskode?</button>
    </form>
    <form class="auth-card" data-forgot hidden>
      <h1>Glemt adgangskode</h1>
      <p class="sub">Vi sender et link til din e-mail, så du kan vælge en ny.</p>
      <div class="field-group"><input name="bruger" autocomplete="username" required autocapitalize="none" spellcheck="false" placeholder="Brugernavn eller e-mail" aria-label="Brugernavn eller e-mail" /></div>
      <p class="msg ok" role="status" hidden></p>
      <button class="btn btn-primary btn-wide" type="submit">Send link</button>
      <button type="button" class="link" data-show-login>Tilbage</button>
    </form>
    <form class="auth-card" data-reset hidden>
      <h1>Ny adgangskode</h1>
      <p class="sub">Mindst 10 tegn. Tre tilfældige ord er nemt at huske.</p>
      <div class="field-group">
        <input name="kode" type="password" autocomplete="new-password" minlength="10" required placeholder="Ny adgangskode" aria-label="Ny adgangskode" />
        <input name="kode2" type="password" autocomplete="new-password" minlength="10" required placeholder="Gentag adgangskode" aria-label="Gentag adgangskode" />
      </div>
      <p class="msg err" role="alert" hidden></p>
      <button class="btn btn-primary btn-wide" type="submit">Gem</button>
    </form>
    <p class="auth-foot">Vækster CRM</p>
  </main>

  <div id="app" class="app" hidden>
    <aside class="sidebar" data-sidebar aria-label="Lister">
      <div class="sb-brand"><span class="mark" aria-hidden="true">V</span><div><strong>Henvendelser</strong><small>{site.name}</small></div></div>
      <nav class="sb-list" data-smart></nav>
      <p class="sb-label">Stages <button type="button" class="sb-edit" data-stages>Redigér</button></p>
      <nav class="sb-list" data-stage-list></nav>
      <p class="sb-label" data-views-label>Mine visninger</p>
      <nav class="sb-list" data-views></nav>
      <button type="button" class="sb-add" data-save-view>+ Gem nuværende visning</button>
      <div class="sb-foot"><span data-me></span><button type="button" class="link" data-logout>Log ud</button></div>
    </aside>
    <div class="scrim" data-scrim hidden></div>

    <main class="main">
      <header class="bar">
        <button type="button" class="icon-btn only-mobile" data-menu aria-label="Åbn lister">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <h1 class="title" data-title>Alle</h1>
        <div class="seg" role="tablist" aria-label="Visning">
          <button type="button" role="tab" data-mode="list">Liste</button>
          <button type="button" role="tab" data-mode="board">Board</button>
        </div>
        <button class="btn btn-primary only-desktop" type="button" data-new>Nyt lead</button>
      </header>

      <div class="tools">
        <label class="search">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input type="search" placeholder="Søg" aria-label="Søg i leads" data-search />
        </label>
        <button type="button" class="chip-btn" data-open="filter">Filter<span data-filter-count></span></button>
        <button type="button" class="chip-btn" data-open="sort">Sortér</button>
        <div class="popover" data-pop="filter" hidden></div>
        <div class="popover" data-pop="sort" hidden></div>
      </div>

      <nav class="chips only-mobile" data-chips aria-label="Hurtige lister"></nav>
      <section class="summary only-desktop" data-stats aria-label="Overblik"></section>
      <section class="view" data-view></section>
    </main>

    <button type="button" class="fab only-mobile" data-new-fab aria-label="Nyt lead">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>
  </div>

  <dialog class="sheet" data-task aria-label="Lead"></dialog>
  <dialog class="sheet sheet-sm" data-stages-dlg aria-label="Redigér stages"></dialog>

  <script src="../../scripts/admin.ts"></script>
</body>
</html>
