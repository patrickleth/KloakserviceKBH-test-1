---
// Mini-CRM for kunden: alle henvendelser fra hjemmesidens formularer + manuelle leads.
// Board (kanban) og liste med filtre, sortering, gemte visninger og egne stages. Inspireret af ClickUp.
// Skjult adresse, noindex, ingen sporing, ikke i sitemap. Data hentes fra /administrator-system/api/ (netlify/functions/admin.mjs).
import '../../styles/_tokens.css';
import '../../styles/admin.css';
import { site } from '../../lib/site';
---
<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Henvendelser | {site.name}</title>
  <link rel="icon" href={site.brand.favicon || site.brand.logo} />
</head>
<body class="crm" data-site={site.name}>
  <main id="login" class="crm-login" hidden>
    <form class="login-card" data-login>
      <img src={site.brand.logo} alt={site.name} class="login-logo" width="180" height="56" />
      <h1>Henvendelser</h1>
      <p class="muted">Log ind for at se og følge op på dine leads.</p>
      <label>Brugernavn<input name="bruger" autocomplete="username" required autocapitalize="none" spellcheck="false" /></label>
      <label>Adgangskode<input name="kode" type="password" autocomplete="current-password" required /></label>
      <p class="crm-error" role="alert" hidden></p>
      <p class="crm-ok" role="status" hidden></p>
      <button class="cbtn cbtn-primary cbtn-block" type="submit">Log ind</button>
      <p class="login-alt"><button type="button" class="linkish" data-show-forgot>Glemt adgangskode?</button></p>
    </form>
    <form class="login-card" data-forgot hidden>
      <img src={site.brand.logo} alt={site.name} class="login-logo" width="180" height="56" />
      <h1>Glemt adgangskode</h1>
      <p class="muted">Skriv dit brugernavn eller din e-mail, så sender vi et link, hvor du kan vælge en ny.</p>
      <label>Brugernavn eller e-mail<input name="bruger" autocomplete="username" required autocapitalize="none" spellcheck="false" /></label>
      <p class="crm-ok" role="status" hidden></p>
      <button class="cbtn cbtn-primary cbtn-block" type="submit">Send link</button>
      <p class="login-alt"><button type="button" class="linkish" data-show-login>Tilbage til log ind</button></p>
    </form>
    <form class="login-card" data-reset hidden>
      <img src={site.brand.logo} alt={site.name} class="login-logo" width="180" height="56" />
      <h1>Vælg ny adgangskode</h1>
      <p class="muted">Mindst 10 tegn. Brug gerne en sætning, fx tre tilfældige ord.</p>
      <label>Ny adgangskode<input name="kode" type="password" autocomplete="new-password" minlength="10" required /></label>
      <label>Gentag adgangskode<input name="kode2" type="password" autocomplete="new-password" minlength="10" required /></label>
      <p class="crm-error" role="alert" hidden></p>
      <button class="cbtn cbtn-primary cbtn-block" type="submit">Gem ny adgangskode</button>
    </form>
  </main>

  <div id="app" class="app" hidden>
    <header class="topbar">
      <div class="brand"><img src={site.brand.logo} alt="" width="120" height="36" /></div>
      <h1 class="space-title">Henvendelser</h1>
      <div class="top-right">
        <span class="me" data-me></span>
        <button class="cbtn cbtn-ghost cbtn-sm" type="button" data-logout>Log ud</button>
      </div>
    </header>

    <nav class="viewbar" aria-label="Visninger">
      <div class="tabs" data-tabs></div>
      <button type="button" class="tab-add" data-save-view>+ Gem visning</button>
    </nav>

    <div class="toolbar">
      <label class="search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Søg i leads" aria-label="Søg i leads" data-search /></label>
      <div class="tool-group">
        <button type="button" class="tbtn" data-open="filter">Filter<b data-filter-count></b></button>
        <button type="button" class="tbtn" data-open="sort">Sortér</button>
        <button type="button" class="tbtn" data-open="group" data-only-list>Gruppér</button>
        <button type="button" class="tbtn" data-stages>Tilpas stages</button>
        <label class="tbtn chk"><input type="checkbox" data-show-archived /> Arkiverede</label>
      </div>
      <button class="cbtn cbtn-primary" type="button" data-new>+ Nyt lead</button>
      <div class="popover" data-pop="filter" hidden></div>
      <div class="popover" data-pop="sort" hidden></div>
      <div class="popover" data-pop="group" hidden></div>
    </div>

    <section class="stats" aria-label="Overblik" data-stats></section>
    <section class="view" data-view></section>
  </div>

  <dialog class="task" data-task aria-label="Lead"></dialog>
  <dialog class="task stages-dlg" data-stages-dlg aria-label="Tilpas stages"></dialog>

  <script src="../../scripts/admin.ts"></script>
</body>
</html>
