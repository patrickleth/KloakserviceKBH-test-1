---
// Ofte stillede spørgsmål som harmonika (details/summary, virker uden JavaScript) + FAQPage-schema.
import { render } from '../lib/markdown';
import Icon from './Icon.astro';
interface Props { heading?: string; items: { q: string; a: string }[] }
const { heading = 'Ofte stillede spørgsmål', items } = Astro.props;
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(render(f.a)) } })) };
---
{items.length > 0 && (
  <section class="faq-sec" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <h2 id="faq-h" class="center">{heading}</h2>
      <div class="faq-list">
        {items.map(f => (
          <details class="faq-item">
            <summary><span>{f.q}</span><Icon name="plus" size={18} class="faq-icon" /></summary>
            <div class="faq-a"><Fragment set:html={render(f.a)} /></div>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
