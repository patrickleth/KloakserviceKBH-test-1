---
import { Picture } from 'astro:assets';
import { resolveImage, remoteOptimizable } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  priority?: boolean;
  width?: number;
  height?: number;
  focus?: string; // top | bottom | left | right | center (beskæring)
}
const { src, alt, widths = [480, 800, 1200, 1600], sizes = '(max-width: 760px) 100vw, 1200px', class: cls, priority = false, width = 1200, height = 800, focus } = Astro.props;
const klass = [cls, focus && `f-${focus}`].filter(Boolean).join(' ') || undefined;
const img = resolveImage(src);
---
{img && typeof img !== 'string' && (
  <Picture
    src={img}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter(w => w <= img.width).concat(widths.some(w => w > img.width) ? [img.width] : [])}
    sizes={sizes}
    class={klass}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
)}
{img && typeof img === 'string' && remoteOptimizable(img) && (
  <Picture
    src={img}
    inferSize
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    class={klass}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
)}
{img && typeof img === 'string' && !remoteOptimizable(img) && (
  <img src={img} alt={alt} class={klass} width={width} height={height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
)}
