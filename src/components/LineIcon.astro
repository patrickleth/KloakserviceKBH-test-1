---
// Linjeikon fra src/lib/icons.ts. Farve følger teksten (currentColor).
import { LINE_ICONS } from '../lib/icons';
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
const d = LINE_ICONS[name] || LINE_ICONS.check;
---
<svg class:list={['line-icon', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
